# Nusxa oling: cp .env.example .env.local (git'ga tushmaydi)

# API manzili. Bo'sh bo'lsa — prod (https://daftaron.firstcoder.uz/api/v1).
# Dev'da mahalliy backend'ni ko'rsating, aks holda dev server haqiqiy bazaga yozadi va mijozlarga SMS ketadi.
# VITE_API_URL=http://localhost:8000/api/v1

# Kirish kodi uzunligi (backend TZ 28.1: hozir 4)
# VITE_OTP_LENGTH=4

# Click / Payme (bo'sh bo'lsa kodda yozilgan prod qiymatlari)
# VITE_CLICK_SERVICE_ID=
# VITE_CLICK_MERCHANT_ID=
# VITE_CLICK_RETURN_URL=
# VITE_PAYME_MERCHANT_ID=
# VITE_PAYME_RETURN_URL=
